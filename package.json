{
  "name": "cadcam-interactive-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/serve.mjs",
    "check:site": "node scripts/validate-site.mjs",
    "release": "pnpm run build && pnpm test && pnpm run check:site && node scripts/package.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "esbuild": "0.25.11",
    "fflate": "0.8.2"
  }
}
